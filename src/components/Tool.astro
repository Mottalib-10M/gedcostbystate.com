---
/** Le simulateur d'une page : un simulateur déclaratif de tool-specs.ts, ou un test d'entraînement (quiz-*). */
import SpecTool from './calc/SpecTool';
import Quiz from './calc/Quiz';
import { route } from '../i18n/routes';
import type { Lang } from '../lib/format';
interface Props { kind: string; lang: Lang; arg?: Record<string, number | string>; idPrefix?: string }
const { kind, lang, arg, idPrefix = 't' } = Astro.props;
---
{kind.startsWith('quiz-')
  ? <Quiz client:load kind={kind} lang={lang} costHref={route('home', lang)} idPrefix={idPrefix} />
  : <SpecTool client:load kind={kind} lang={lang} arg={arg ? JSON.stringify(arg) : undefined} methodHref={route('method', lang)} idPrefix={idPrefix} />}
