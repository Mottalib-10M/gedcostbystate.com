---
/**
 * Accueil : le calculateur de coût, quatre repères en cartes, la réponse repliée, la phrase de valeur ajoutée,
 * le tableau des 50 États et de Washington, D.C., les explications, les pages par famille, les règles en
 * accordéons, la FAQ. Texte : src/content/home.ts ; montants : pages d'État lues (src/data/hse.json).
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { byName, usd0, num, resText, T } from '../lib/data';
import { full } from '../lib/stats';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const statePage = new Map(GUIDES.filter((g) => g.state).map((g) => [g.state!, g.id]));
const cell = (code: string, t: 'ged' | 'hiset', m: 'center' | 'online') => { const r = full(code, t, m); return r.available ? usd0(r.total, lang) : ''; };
const rows = byName(lang).map((s) => {
  const id = statePage.get(s.code);
  const name = id && hasRoute(id, lang) ? `<a href="${route(id, lang)}">${s[lang]}</a>` : s[lang];
  return [name, s.ged ? cell(s.code, 'ged', 'center') : T(lang, 'not offered', 'no se ofrece'), s.ged ? cell(s.code, 'ged', 'online') || T(lang, 'not listed', 'no indicado') : '', s.hiset ? cell(s.code, 'hiset', 'center') || T(lang, 'set by center', 'lo fija el centro') : '', s.ged ? num(s.ged.age, lang, s.ged.age % 1 ? 1 : 0) : num(s.hiset!.age ?? 18, lang), resText((s.ged ?? s.hiset)!.res, lang)];
});
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p class="mt-1 text-sm text-navy-600"><a href={route('method', lang)} class="underline">{T(lang, 'Method and sources', 'Método y fuentes')}</a> · <a href={route('about', lang)} class="underline">{T(lang, 'Who publishes this site', 'Quién publica este sitio')}</a></p>
  </header>
  <div data-outil data-chrome><Tool kind="cost" lang={lang} arg={{ st: 'TX', test: 'ged' }} idPrefix="home" /></div>
  <ul data-chrome class="my-6 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
    {x.facts.map((f) => <li class="rounded-lg border border-navy-200 bg-white p-3"><span class="block text-navy-600">{f.k}</span><strong class="mt-1 block text-base text-navy-900">{f.v}</strong></li>)}
  </ul>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <p class="my-6 border-l-4 border-accent-500 pl-4 text-navy-800"><strong>{x.valeur}</strong></p>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{T(lang, 'The whole test, state by state', 'El examen completo, estado por estado')}</h2>
    <p class="mt-2 text-navy-700">{x.tableIntro}</p>
    <div data-chrome><Fragment set:html={h.table([T(lang, 'State', 'Estado'), T(lang, 'GED, test center', 'GED, centro'), T(lang, 'GED, online', 'GED, en línea'), T(lang, 'HiSET, test center', 'HiSET, centro'), T(lang, 'Age', 'Edad'), T(lang, 'Residency', 'Residencia')], rows, T(lang, 'First pass of all parts (4 GED subjects, 5 HiSET subtests), with discounts open to everyone. Age = age with no extra conditions.', 'Primer paso de todas las partes (4 materias del GED, 5 pruebas del HiSET), con los descuentos abiertos a todos. Edad = edad sin condiciones adicionales.'), ['l', 'r', 'r', 'r', 'r', 'l'])} /></div>
  </section>
  <section class="mt-10"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10" data-chrome>
    {GROUPS.map((g) => {
      const list = GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h2 class="text-xl font-bold text-navy-900">{g.label[lang]}</h2>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p[lang].nav}</a><span class="block text-navy-600">{p[lang].card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
</PageLayout>
