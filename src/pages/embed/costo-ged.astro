---
/** Page à intégrer (iframe) : le calculateur de coût seul. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../data/site-config';
const lang = 'es';
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Costo del GED y del HiSET por estado (calculadora para insertar)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/es/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind="cost" lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/es/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · tarifas del GED y del HiSET leídas en las páginas estatales de ged.com y hiset.org · sin relación con GED Testing Service ni ETS</p>
  </body>
</html>
